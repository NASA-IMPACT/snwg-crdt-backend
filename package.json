        "nodemon": "^3.1.11",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.29.1",
        "vitest": "^4.0.18",
        "ws": "^8.19.0"
    },
    "pnpm": {
        "patchedDependencies": {
            "aws-jwt-verify@5.1.1": "patches/aws-jwt-verify@5.1.1.patch",
            "@hocuspocus/extension-s3@3.4.0": "patches/@hocuspocus__extension-s3@3.4.0.patch"
