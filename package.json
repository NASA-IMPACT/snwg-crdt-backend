{
    "name": "snwg-crdt-backend",
    "version": "1.0.0",
    "description": "SNWG CRDT backend",
    "type": "module",
    "scripts": {
        "lint:js": "eslint ./app ./assets",
        "lint:unused": "knip --tags=-knipignore --no-gitignore",
        "lint:ts": "tsc",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "tsoa:generate": "tsoa spec-and-routes",
        "start": "TS_NODE_COMPILER_OPTIONS='{\"sourceMap\":true}' TS_NODE_LOG_ERROR=true node --disable-warning=ExperimentalWarning --disable-warning=DeprecationWarning --loader ts-node/esm app/main.ts",
        "dev": "concurrently \"nodemon --config nodemon.app.json\" \"nodemon --config nodemon.tsoa.json\""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@hocuspocus/extension-logger": "^3.4.0",
        "@hocuspocus/extension-s3": "^3.4.0",
        "@hocuspocus/server": "^3.4.0",
        "@slate-yjs/core": "^1.0.2",
        "@tsoa/runtime": "^6.6.0",
        "aws-jwt-verify": "^5.1.1",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "envalid": "^8.1.1",
        "express": "^5.1.0",
        "express-ws": "^5.0.2",
        "helmet": "^8.1.0",
        "morgan": "^1.10.1",
        "swagger-ui-express": "^5.0.1",
        "tsoa": "^6.6.0",
        "y-protocols": "^1.0.6",
        "yaml": "^2.8.2",
        "yjs": "^13.6.27"
    },
    "packageManager": "pnpm@8.15.9+sha512.499434c9d8fdd1a2794ebf4552b3b25c0a633abcee5bb15e7b5de90f32f47b513aca98cd5cfd001c31f0db454bc3804edccd578501e4ca293a6816166bbd9f81",
    "devDependencies": {
        "@eslint/js": "^9.24.0",
        "@hocuspocus/provider": "^2.15.2",
        "@stylistic/eslint-plugin": "^5.7.1",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.5",
        "@types/express-ws": "^3.0.6",
        "@types/morgan": "^1.9.10",
        "@types/node": "^22.14.1",
        "@types/supertest": "^6.0.3",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/ws": "^8.18.1",
        "@vitest/coverage-v8": "^4.0.18",
