{
  "entryFile": "app/main.ts",
    "noImplicitAdditionalProperties": "throw-on-extras",
    "controllerPathGlobs": ["./app/routes/**/*.ts"],
    "spec": {
        "outputDirectory": "generated",
        "specVersion": 3,
        "name": "SNWG CRDT Backend",
        "description": "API for SNWG CRDT Backend",
        "yaml": true,
        "securityDefinitions": {
            "jwt": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "routes": {
        "routesDir": "generated",
        "rewriteRelativeImportExtensions": true,
        "authenticationModule": "./app/authentication.ts",
        "middleware": "express"
    }
}
